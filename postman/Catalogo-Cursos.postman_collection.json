{
  "info": {
    "_postman_id": "073d3213-9bb3-4372-a701-6238f7b8eca4",
    "name": "Catálogo de Cursos — Exemplos executáveis",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Importe também o ambiente LOCAL fornecido e selecione-o. Execute a coleção inteira, em ordem. Cada execução gera emails exclusivos, captura IDs e verifica resultados. Os cenários com 400/401/403/404/409 são testes negativos esperados e devem aparecer como PASS."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "jwtInvalido",
      "value": "jwt-invalido-para-teste"
    }
  ],
  "item": [
    {
      "name": "01 — Health e preparação da execução",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get(\"login\") || !pm.environment.get(\"senha\")) {",
              "    throw new Error(\"Selecione o ambiente Catálogo de Cursos - LOCAL fornecido com esta coleção.\");",
              "}",
              "const id = pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\");",
              "pm.environment.set(\"runId\", id);",
              "pm.environment.set(\"loginOperador\", \"operador_\" + id);",
              "pm.environment.set(\"senhaOperador\", \"Demo!\" + id);",
              "[\"accessToken\",\"refreshToken\",\"refreshAnterior\",\"operatorAccessToken\",\"instrutorId\",\"cursoId\",\"pessoaId\",\"alunoId\",\"matriculaId\",\"contaId\"].forEach(k => pm.environment.unset(k));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Login do administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/autenticacao/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"{{login}}\",\n  \"senha\": \"{{senha}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const dados = pm.response.json();",
              "  pm.environment.set(\"accessToken\", dados.accessToken);",
              "  pm.environment.set(\"refreshToken\", dados.refreshToken);",
              "pm.test(\"JWT e refresh recebidos\", () => { pm.expect(dados.accessToken).to.be.a(\"string\").and.not.empty; pm.expect(dados.refreshToken).to.be.a(\"string\").and.not.empty; });",
              "}"
            ]
          }
        }
      ]
    },
