{
  "info": {
    "name": "Catálogo de Cursos — Aulas 00 a 17",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Preencha login, senha e senhaOperador apenas nas variáveis locais. Cadastros capturam IDs e login/refresh capturam tokens. Não exporte credenciais nem tokens preenchidos."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "login",
      "value": ""
    },
    {
      "key": "senha",
      "value": ""
    },
    {
      "key": "senhaOperador",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "instrutorId",
      "value": ""
    },
    {
      "key": "cursoId",
      "value": ""
    },
    {
      "key": "pessoaId",
      "value": ""
    },
    {
      "key": "alunoId",
      "value": ""
    },
    {
      "key": "colaboradorId",
      "value": ""
    },
    {
      "key": "matriculaId",
      "value": ""
    },
    {
      "key": "contaId",
      "value": ""
    },
    {
      "key": "emailInstrutor",
      "value": ""
