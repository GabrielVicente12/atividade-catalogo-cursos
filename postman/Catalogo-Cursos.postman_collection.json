          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/instrutores",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Marina Costa\",\n  \"email\": \"marina.{{runId}}@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "  const dados = pm.response.json();",
              "  pm.environment.set(\"instrutorId\", dados.id);",
              "pm.test(\"Location do instrutor\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/instrutores/\" + dados.id));",
              "}"
            ]
          }
        }
